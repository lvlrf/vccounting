# Database Configuration
DATABASE_URL=postgresql://admin:password@localhost:5432/reseller_panel

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

# Encryption (برای رمزگذاری credentials پنل‌ها)
ENCRYPTION_KEY=your-encryption-key-here-change-in-production

# Application
DEBUG=True
APP_NAME=Reseller Management Panel
APP_VERSION=1.0.0

# CORS Settings
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:8080

# Admin Default User (برای اولین راه‌اندازی)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@example.com

# Background Jobs
ENABLE_SCHEDULER=True
SYNC_ACCOUNTS_INTERVAL_HOURS=1
