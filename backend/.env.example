# Database Configuration (MySQL)
DATABASE_URL=mysql+pymysql://admin:password@localhost:3306/reseller_panel?charset=utf8mb4

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

# Encryption (برای رمزگذاری credentials پنل‌ها)
ENCRYPTION_KEY=your-encryption-key-here-change-in-production

# Application
DEBUG=True
APP_NAME=Reseller Management Panel
APP_VERSION=1.0.0

# CORS Settings
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:8080

# Admin Default User (برای اولین راه‌اندازی)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@example.com

# Background Jobs
ENABLE_SCHEDULER=True
SYNC_ACCOUNTS_INTERVAL_HOURS=1

# Redis Configuration (for Celery & Caching)
REDIS_URL=redis://localhost:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
